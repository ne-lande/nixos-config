// Niri configuration file (KDL)
// Refer to https://niri-wm.github.io/niri/Configuration for full documentation

prefer-no-csd

// waybar is started by its systemd user unit (programs.waybar.systemd)
spawn-at-startup "kitten" "quick-access-terminal"

output "DP-1" {
     mode "5120x1440@144.000"
     scale 1.0
     // Always-on VRR on NVIDIA causes cursor-driven refresh oscillation and
     // frame-pacing stutter; only enable it for windows that opt in below.
     variable-refresh-rate on-demand=true
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
}

binds {
    Mod+Return { spawn-sh "kitten quick-access-terminal"; }
    Mod+Shift+D { spawn "fuzzel"; }
    Mod+Shift+N { spawn "nautilus"; }
    Mod+Q { close-window; }
    Mod+Shift+Q { quit; }
    Mod+L { spawn "swaylock"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }

    Mod+Space { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+O { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Print { screenshot; }
    Mod+Print { screenshot-window; }
    //Mod+Shift+Print { screenshot-screen write-to-disk=false; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
}

layout {
    gaps 16
    center-focused-column "on-overflow"
    empty-workspace-above-first
    default-column-display "tabbed"
    background-color "#003300"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        on
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        off
    }

    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap 5
        width 4
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 8
        active-color "red"
        inactive-color "gray"
        urgent-color "blue"
    }

    insert-hint {
        on
        color "#ffc87f80"
    }
}

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 48
}

clipboard {
    disable-primary
}

// Steam friend/activity notification popups have an empty title unlike the
// main Steam window. open-focused false stops them stealing keyboard focus.
// If the popup still appears centered, run `niri msg windows` while one is
// visible to get the exact app-id/title and adjust the match below.
window-rule {
    match app-id=r#"^steam$"# title=r#"^$"#
    open-focused false
    default-floating-position relative-to="bottom-right" x=-16 y=-16
}

// Zoom creates many small unnamed popup windows (presentation toolbar, reactions, etc.)
// that grab focus on hover and cause the flashing/reappearing effect.
// open-focused false stops them stealing keyboard focus.
// open-floating true keeps them from being tiled, which breaks their positioning.
window-rule {
    match app-id=r#"zoom"# title=r#"^$"#
    open-focused false
    open-floating true
}

// All other Zoom windows (main, meeting, screen share) work better floating —
// Zoom manages its own internal layout and fights tiling compositors.
window-rule {
    match app-id=r#"zoom"#
    open-floating true
}

// Steam games (app-id steam_app_<id>) get VRR via the on-demand output
// setting above, so the desktop runs fixed 144Hz but games still adapt.
window-rule {
    match app-id=r#"^steam_app_"#
    variable-refresh-rate true
}
