// Niri configuration file (KDL)
// Refer to https://niri-wm.github.io/niri/Configuration for full documentation

prefer-no-csd

spawn-at-startup "waybar"
spawn-at-startup "kitten" "quick-access-terminal"

// Run `niri msg outputs` on first boot to get the exact output name and mode.
output "eDP-1" {
    mode "2560x1600@120.00"
    scale 1.5
    variable-refresh-rate
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }
}

binds {
    Mod+Return { spawn-sh "kitten quick-access-terminal"; }
    Mod+Shift+D { spawn "fuzzel"; }
    Mod+Shift+N { spawn "nautilus"; }
    Mod+Q { close-window; }
    Mod+Shift+Q { quit; }
    Mod+L { spawn "swaylock"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }

    Mod+Space { toggle-window-floating; }
    Mod+F { fullscreen-window; }

    Print { screenshot; }
    //Mod+Print { screenshot-window write-to-disk=false; }
    //Mod+Shift+Print { screenshot-screen write-to-disk=false; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }

    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
}

layout {
    gaps 16
    center-focused-column "on-overflow"
    empty-workspace-above-first
    default-column-display "tabbed"
    background-color "#003300"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        on
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        off
    }

    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap 5
        width 4
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 8
        active-color "red"
        inactive-color "gray"
        urgent-color "blue"
    }

    insert-hint {
        on
        color "#ffc87f80"
    }
}

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 48
}

clipboard {
    disable-primary
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^$"#
    open-focused false
    default-floating-position relative-to="bottom-right" x=-16 y=-16
}

// Zoom creates many small unnamed popup windows (presentation toolbar, reactions, etc.)
// that grab focus on hover and cause the flashing/reappearing effect.
// open-focused false stops them stealing keyboard focus.
// open-floating true keeps them from being tiled, which breaks their positioning.
window-rule {
    match app-id=r#"zoom"# title=r#"^$"#
    open-focused false
    open-floating true
}

// All other Zoom windows (main, meeting, screen share) work better floating —
// Zoom manages its own internal layout and fights tiling compositors.
window-rule {
    match app-id=r#"zoom"#
    open-floating true
}
